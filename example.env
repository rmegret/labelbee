SECRET_KEY=secret-key

MYSQL_DATABASE=db
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=5432

LABELBEE_PORT=port-number
LABELBEE_LOGDIR=log-directory
LABELBEE_APPDIR=labelbee-root-directory
PATH="$LABELBEE_APPDIR:$PATH"

DATA_DIR=path-to-data-directory

MAIL_PASSWORD=my-password

# DataInfrastructure API (videos and datasets come from here)
DATAINFRA_API_URL=http://localhost:8000
DATAINFRA_TIMEOUT=15
# Path prefix stored in DataInfrastructure that corresponds to DATA_DIR.
# A DataInfrastructure file /mnt/data/a/b.mp4 is served as /data/a/b.mp4
DATAINFRA_PATH_PREFIX=/mnt/data
